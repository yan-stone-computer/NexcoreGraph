# 启核图策 · 后端本地配置模板
# 复制成 backend/.env 后填真值；backend/.env 已在 .gitignore 内，不会被提交。

# AI 网关（Agnes，OpenAI 兼容）
AGNES_API_KEY=sk-xxxxxxxxxxxxxxxx
AGNES_MODEL=agnes-2.0-flash

# 登录验证码发信（邮箱账号走这里）
# 163 邮箱：设置 → POP3/SMTP/IMAP → 开启 SMTP 服务 → 生成"授权码"，
# 注意 MAIL_PASS 填的是授权码，不是邮箱登录密码。
MAIL_HOST=smtp.163.com
MAIL_PORT=465
MAIL_USER=covabond@163.com
MAIL_PASS=
# 可选：发件人显示地址，缺省等于 MAIL_USER
MAIL_FROM=

# 可选：手机号账号的短信通道（不配则验证码只打服务端日志）
SMS_ENDPOINT=
SMS_API_KEY=

# 可选：本地联调时让 /api/auth/code 在响应里回带验证码（生产不要开）
# AUTH_SHOW_CODE=1
