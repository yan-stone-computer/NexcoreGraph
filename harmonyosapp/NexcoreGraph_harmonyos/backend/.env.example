# 启核图策 · Node 后端环境模板
# 复制为 backend/.env；该文件已被 .gitignore 排除，禁止提交真实值。

# HTTP
PORT=3000

# MySQL 8
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=nxg_app
DB_PASSWORD=
DB_NAME=tianshu

# AI 网关（Key 只在服务端）
AGNES_API_KEY=
AGNES_BASE_URL=https://api.agnes-ai.cn/v1
AGNES_MODEL=agnes-2.0-flash
AGNES_MODEL_ALT=agnes-3.0-flash
AI_TIMEOUT_MS=25000
AI_RPM=20

# 登录验证码邮件
MAIL_HOST=smtp.163.com
MAIL_PORT=465
MAIL_USER=
MAIL_PASS=
MAIL_FROM=

# 可选短信通道
SMS_ENDPOINT=
SMS_API_KEY=

# 生产必须为 0，禁止在 API 响应中回带验证码
AUTH_SHOW_CODE=0
