# 启核图策 · Node 后端环境模板
# 复制为 backend/.env；该文件已被 .gitignore 排除，禁止提交真实值。

# HTTP
PORT=3000

# MySQL 8
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=nxg_app
DB_PASSWORD=
DB_NAME=tianshu

# AI 网关（Key 只在服务端）
# 预设：openai | deepseek | qwen | moonshot | zhipu | siliconflow | ollama |
#       anthropic | gemini | agnes | custom-openai | custom-anthropic | custom-gemini
AI_PROVIDER=agnes
AI_PROTOCOL=openai
AI_BASE_URL=https://api.agnes-ai.cn/v1
AI_API_KEY=
AI_MODEL=agnes-2.0-flash
AI_MODEL_ALT=agnes-3.0-flash
AI_VISION_MODELS=agnes-2.5-flash,agnes-3.0-flash,agnes-2.0-flash
AI_CONTEXT_WINDOW=32768
AI_MAX_TOKENS=600
# 只有需要在 App 内修改平台/模型/Key 时才配置；使用长随机值。
AI_CONFIG_ADMIN_TOKEN=
# 允许小程序请求头覆盖服务端模型配置（仅建议局域网演示环境开启）
ALLOW_CLIENT_AI_OVERRIDE=1
AI_TIMEOUT_MS=25000
AI_RPM=20

# 登录验证码邮件
MAIL_HOST=smtp.163.com
MAIL_PORT=465
MAIL_USER=
MAIL_PASS=
MAIL_FROM=

# 可选短信通道
SMS_ENDPOINT=
SMS_API_KEY=

# 生产必须为 0，禁止在 API 响应中回带验证码
AUTH_SHOW_CODE=0
