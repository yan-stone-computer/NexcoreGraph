# 启核图策 · 微信小程序端本机配置模板
# 用法：复制成同目录下的 .env（或 .env.local）再填真值；.env 已在 .gitignore 内，不会进仓库。
# Taro 只会把 TARO_APP_ 前缀的变量注入代码（构建期 definePlugin）。
# 不填也能用：AI 默认走自建后端 /api/ai/*（Key 在后端环境变量），
#            或在「我的 → 服务器连接 · AI 通道」里直接粘贴 Key（存本机 Storage）。

# 厂商直连通道（自建网关连不上时回落用）
TARO_APP_AI_KEY=
TARO_APP_AI_MODEL=agnes-2.5-flash
TARO_APP_AI_VENDOR_BASE=https://api.agnes-ai.cn/v1
