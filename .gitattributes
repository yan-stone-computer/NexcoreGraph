# Keep source text normalized in the repository.
* text=auto
*.js text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.ets text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.html text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.py text eol=lf

# Preserve executable scripts and Windows launchers.
*.sh text eol=lf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary assets must not be line-ending converted.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.pdf binary
*.docx binary
*.pptx binary
*.zip binary
*.mp4 binary
*.woff binary
*.woff2 binary
